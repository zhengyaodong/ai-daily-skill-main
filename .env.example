# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 阿里百炼（通义千问 Qwen）API 配置
K2_API_KEY=your_dashscope_api_key_here
K2_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
K2_MODEL=qwen3.7-plus
K2_API_ENDPOINT=/chat/completions

# 兼容旧配置（自动从上方继承，无需重复设置）
# ZHIPU_API_KEY=（自动等于 K2_API_KEY）
# ANTHROPIC_BASE_URL=（自动等于 K2_BASE_URL）

# 邮件通知配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_TO=recipient@email.com

# GitHub Pages URL（用于邮件中的链接）
GITHUB_PAGES_URL=https://yourname.github.io/ai-daily-skill

# 可选：RSS 源（默认使用多源聚合配置）
# RSS_URL=https://techcrunch.com/category/artificial-intelligence/feed/
